def cmd_init():
    if os.path.exists(SUBJECT):
        print(f"{SUBJECT} already exists — not overwriting")
        return 1
    with open(SUBJECT, "w") as f:
        f.write(TEMPLATE)
    print(f"wrote {SUBJECT}")
    return 0


def extract_from_pdf_text(text):
    """Best-effort: find 'Rush 0N' chapter titles and the rush(x, y) examples after them."""
    sections = {}
    sec = None
    lines = text.split("\n")
    i = 0
    while i < len(lines):
        s = lines[i].strip()
        m = re.fullmatch(r"(?:Chapter\s+\w+\s+)?Rush\s*0?(\d)", s)
        if m:
            sec = int(m.group(1))
            sections.setdefault(sec, [])
            i += 1
            continue
        mh = EX_HEAD.search(s)
        if mh and sec is not None:
            j = i + 1
            while j < len(lines) and j < i + 4 and "a.out" not in lines[j] \
                    and not lines[j].strip().startswith("$>"):
                j += 1
            if j < len(lines) and ("a.out" in lines[j] or lines[j].strip().startswith("$>")):
                rows, k = [], j + 1
                while k < len(lines) and not lines[k].strip().startswith("$>") and k < j + 200:
                    if lines[k].strip():
                        rows.append(lines[k].rstrip())
                    k += 1
                sections[sec].append((int(mh.group(1)), int(mh.group(2)), rows))
                i = k + 1
                continue
        i += 1
    return sections


def subject_text_from_pdf(path, label=None):
    """Build subject.txt text from a PDF. Raises ValueError with a readable reason."""
    if not shutil.which("pdftotext"):
        raise ValueError("pdftotext not found (poppler) — paste the examples by hand")
    text = subprocess.run(["pdftotext", "-layout", path, "-"], capture_output=True,
                          text=True).stdout
    found = extract_from_pdf_text(text)
    if not found:
        raise ValueError("could not find any 'Rush 0N' sections with rush(x, y) examples in that PDF")
    label = label or os.path.basename(path)
    if True:
        out = [TEMPLATE.split("# One section per rush.")[0].rstrip(), "",
               f"# extracted from {label} on {time.strftime('%Y-%m-%d %H:%M')}"
               " — check every block below against the PDF", ""]
        for n in sorted(found):
            d = derive_rush(None, [(x, y, _clean_rows(r, x)) for x, y, r in found[n]])
            out.append(f"== rush{n:02d}")
            if d["pattern"]:
                p = d["pattern"]
                out.append("pattern = " + " ".join("'" + "".join(r) + "'" for r in p)
                           + "   # " + (d["source"] or ""))
            for note in d["notes"]:
                out.append("# note: " + note)
            for x, y, rows in found[n]:
                out.append(f"rush({x}, {y})")
                out.extend(rows)
                out.append("")
            out.append("")
    return "\n".join(out)


def save_subject(text):
    """Write subject.txt, keeping the previous one as a timestamped .bak."""
    bak = None
    if os.path.exists(SUBJECT):
        bak = SUBJECT + time.strftime(".%Y%m%d-%H%M%S.bak")
        shutil.copy(SUBJECT, bak)
    with open(SUBJECT, "w", encoding="utf-8") as f:
        f.write(text)
    return bak


def cmd_subject(path):
    if path.lower().endswith(".pdf"):
        try:
            text_out = subject_text_from_pdf(path)
        except ValueError as e:
            print(e)
            return 1
    else:
        with open(path, encoding="utf-8") as f:
            text_out = f.read()
    bak = save_subject(text_out)
    if bak:
        print(c(DIM, f"old subject saved as {bak}"))
    s = Subject.load()
    print(f"wrote {SUBJECT}\n")
    print_subject(s)
    return 0


def print_subject(s):
    for k in ("dir", "files", "allowed", "flags", "function", "assign"):
        v = s.cfg[k]
        print(f"  {k:9}= {' '.join(v) if isinstance(v, list) else (v or '-')}")
    if not s.rushes:
        print(c(WARN, "  no rush sections — every rush will be self-checked only"))
    for n in sorted(s.rushes):
        d = s.derived[n]
        pat = d["pattern"]
        tile = " ".join("".join(r) for r in pat) if pat else "?"
        flag = c(OK, "generates tests") if d["generate"] else c(WARN, "examples only")
        print(f"  rush{n:02d}  [{tile}]  {len(d['valid_examples'])} example(s)  {flag}")
        for note in d["notes"]:
            print(c(WARN, f"          ! {note}"))


