def grid_html(text, other=None, role="got", crop=None):
    """Render text as a char grid. other: the text to compare against (marks cells)."""
    rows = _rows(text)
    orows = _rows(other) if other is not None else None
    r0, r1, c0, c1 = crop or (0, len(rows), 0, max((len(r) for r in rows), default=0))
    out = []
    for ri in range(r0, min(r1, len(rows))):
        row = rows[ri]
        orow = orows[ri] if orows is not None and ri < len(orows) else None
        cells = []
        for ci in range(c0, min(c1, len(row))):
            ch = row[ci]
            disp = "·" if ch == " " else (ch if ch.isprintable() else "?")
            cls = "sp" if ch == " " else ("np" if not ch.isprintable() else "")
            if orows is not None and (orow is None or ci >= len(orow) or orow[ci] != ch):
                cls = "b" if role == "got" else "m"
            cells.append(f'<span class="{cls}">{cm.esc(disp)}</span>' if cls else cm.esc(disp))
        last = ri == len(rows) - 1
        eol = "" if (last and not text.endswith("\n")) else '<span class="eol">$</span>'
        out.append("".join(cells) + eol)
    return "\n".join(out)


def test_card(t):
    x, y, cat = t["x"], t["y"], t["cat"]
    ok = t["ok"]
    st = '<span class="st ok">✓</span>' if ok else '<span class="st bad">✗</span>'
    if cat == "edge" and not ok:
        st = '<span class="st warn">!</span>'
    got, exp = t["got"], t["exp"]
    big = y > 30 or x > 60
    cls = "tcase" + (" bad" if not ok and cat != "edge" else "") + (" wide" if big and not ok else "")
    head = (f'<div class="th"><code>rush({x}, {y})</code>{st}'
            f'<span class="cat">{cm.esc(cat)}</span></div>')
    why = f'<div class="why">{cm.esc(t["why"])}</div>' if t["why"] else ""
    if cat == "stress":
        body = (f'<div class="subnote">{t["size"]:,} bytes printed'
                + (", matches" if ok else "") + "</div>")
        return f'<div class="{cls}">{head}{why}{body}</div>'
    if not got:
        body = '<div class="empty">(no output)</div>'
        return f'<div class="{cls}">{head}{why}{body}</div>'
    crop = None
    if big:
        if ok:
            body = (f'<div class="grid small">{grid_html(got)}</div>')
            return f'<div class="{cls}">{head}{body}</div>'
        e, g = _rows(exp or ""), _rows(got)
        fr = next((i for i in range(max(len(e), len(g)))
                   if (e[i] if i < len(e) else None) != (g[i] if i < len(g) else None)), 0)
        fc = 0
        if fr < len(e) and fr < len(g):
            fc = next((i for i in range(max(len(e[fr]), len(g[fr])))
                       if (e[fr][i:i + 1]) != (g[fr][i:i + 1])), 0)
        crop = (max(fr - 3, 0), fr + 6, max(fc - 12, 0), fc + 40)
    if ok or exp is None:
        body = f'<div class="grids"><div class="gridbox"><div class="grid">{grid_html(got, crop=crop)}</div></div></div>'
    else:
        note = (f'<div class="subnote">showing rows {crop[0] + 1}–{crop[1]}, cols {crop[2] + 1}–{crop[3]} '
                f'around the first difference</div>' if crop else "")
        eg = (f'<div class="grid">{grid_html(exp, got, "exp", crop)}</div>' if exp
              else '<div class="empty">(no output)</div>')
        body = (f'{note}<div class="grids"><div class="gridbox"><div class="cap">expected</div>{eg}</div>'
                f'<div class="gridbox"><div class="cap">got</div>'
                f'<div class="grid">{grid_html(got, exp, "got", crop)}</div></div></div>')
    return f'<div class="{cls}">{head}{why}{body}</div>'


def tile(pat, other=None, cap=""):
    if not pat:
        return ""
    cells = []
    for r in range(3):
        for k in range(3):
            ch = pat[r][k]
            bad = other is not None and other[r][k] != ch
            cells.append(f'<span class="{"bad" if bad else ""}">{cm.esc("␣" if ch == " " else ch)}</span>')
    return f'<div class="tilebox"><div class="tile">{"".join(cells)}</div><div class="cap">{cm.esc(cap)}</div></div>'


def questions(team):
    qs = []
    funcs = [f for P in team.parsed for f in P.funcs]
    n = team.assigned if team.assigned is not None else (min(team.rush_results) if team.rush_results else None)
    R = team.rush_results.get(n) if n is not None else None
    entry = next((f for f in funcs if R and f.file == R["file"] and f.name == R["entry"]), None)
    if R:
        for t in [t for t in R["tests"] if t["ok"] is False and t["cat"] in ("subject", "core")][:3]:
            qs.append(f"<code>rush({t['x']}, {t['y']})</code> is wrong ({cm.esc(t['why'])}). "
                      "Ask them to trace it on paper and find the line.")
        edge = [t for t in R["tests"] if t["cat"] == "edge"]
        noisy = [t for t in edge if t["got"] or t["crash"]]
        if noisy:
            t = noisy[0]
            what = t["crash"] or f"prints {len(t['got'])} bytes"
            qs.append(f"<code>rush({t['x']}, {t['y']})</code> {cm.esc(what)}. What should happen for "
                      "x or y ≤ 0, and where does the code decide that?")
        elif entry:
            guard = [nd for nd in cm.walk(entry.outline) if nd["k"] == "if"
                     and re.search(r"(<=?\s*0|<\s*1|==\s*0)", nd["branches"][0][1])]
            if guard:
                qs.append(f"Show me the check that stops <code>rush(0, 5)</code> in "
                          f"<code>{cm.esc(entry.name)}</code> (line {guard[0]['line']}). "
                          "Why <code>" + cm.esc(guard[0]["branches"][0][1]) + "</code>?")
    loops = [(f, nd) for f in funcs for nd in cm.walk(f.outline) if nd["k"] == "loop"]
    for f, nd in loops[:3]:
        qs.append(f"In <code>{cm.esc(f.name)}</code> (line {nd['line']}): why "
                  f"<code>while ({cm.esc(nd['cond'])})</code>? What prints if the bound is off by one?")
    callers = {}
    for f in funcs:
        for cname in set(f.callees()):
            callers.setdefault(cname, set()).add(f.name)
    for f in funcs:
        cnt = sum(1 for g in funcs for cname, _ in g.calls if cname == f.name)
        if cnt >= 2 and f.name not in ("main", "ft_putchar"):
            qs.append(f"<code>{cm.esc(f.name)}</code> is called {cnt} times. What changes between those "
                      "calls, and why make it a separate function?")
            break
    for f in funcs:
        if f.name not in callers and f.name != "main" and not any(
                R2["entry"] == f.name for R2 in team.rush_results.values()):
            qs.append(f"<code>{cm.esc(f.name)}</code> ({cm.esc(f.file)}) is never called. Why is it there?")
    if any(f.authors for f in funcs):
        everyone = sorted({a for f in funcs for a in f.authors})
        asked = 0
        for f in sorted(funcs, key=lambda f: -f.nlines):
            if not f.authors or len(everyone) < 2:
                break
            top = f.authors.most_common(1)[0][0]
            other = next((a for a in everyone if a != top), None)
            if other:
                qs.append(f"Ask <b>{cm.esc(other)}</b> to explain <code>{cm.esc(f.name)}</code> "
                          f"(mostly written by {cm.esc(top)}).")
                asked += 1
            if asked >= 3:
                break
    qs.append("Edit <code>main.c</code> live to <code>rush(123, 42)</code>, then <code>rush(1, 1)</code>, and "
              f"recompile with <code>{cm.esc(' '.join(team.cfg['flags']))}</code>.")
    qs.append("How does <code>ft_putchar</code> get a char on screen? What are the 3 arguments of "
              "<code>write</code>?")
    return qs


def report_html(team):
    v_cls, v_txt = team.verdict()
    files = sorted({P.name for P in team.parsed})
    colors = {f: cm.PALETTE[i % len(cm.PALETTE)] for i, f in enumerate(files)}
    funcs = [f for P in team.parsed for f in P.funcs]
    known = {}
    for f in funcs:
        known.setdefault(f.name, cm.fn_anchor(f))
    entries = {(R["file"], R["entry"]) for R in team.rush_results.values() if R["entry"]}
    called = {cname for f in funcs for cname in f.callees()}
    flags = {}
    for f in funcs:
        fl = set()
        if (f.file, f.name) in entries or f.name == "main":
            fl.add("entry")
        elif f.name not in called:
            fl.add("dead")
        if f.nlines > 25:
            fl.add("over")
        flags[f.id] = fl

    parts = []
    assigned = (f"rush{team.assigned:02d} <span class=dim>({cm.esc(team.assigned_why)})</span>"
                if team.assigned is not None else
                '<span class="st warn">unknown</span> <span class=dim>— pass --rush N or --leader LOGIN</span>')
    parts.append(f'<header class="top"><h1>{cm.esc(team.name)}</h1>'
                 f'<span class="pill verdict {v_cls}">{cm.esc(v_txt)}</span>'
                 f'<div class="kv"><span>assigned: {assigned}</span>'
                 f'<span class="dim">{cm.esc(team.path)}</span>'
                 f'<span class="dim">{time.strftime("%Y-%m-%d %H:%M")}</span>'
                 f'<span class="dim">subject: {"subject.txt" if team.S.loaded else "built-in core only"}</span></div>'
                 f'<button class="themebtn" type="button">◐ theme</button></header>')
    parts.append('<nav class="toc"><a href="#checks">Checklist</a><a href="#output">Output</a>'
                 '<a href="#structure">Structure</a><a href="#main">Their main</a>'
                 '<a href="#questions">Defense questions</a><a href="#source">Source</a>'
                 '<a href="index.html">← all teams</a></nav>')

    # checklist
    rows = []
    for label, st, html_, text in team.checks:
        sym = {"ok": "✓ OK", "bad": "✗ FAIL", "warn": "! CHECK", "na": "– n/a"}[st]
        rows.append(f'<tr><td class="st {st}">{sym}</td><td><b>{cm.esc(label)}</b></td>'
                    f'<td>{html_ or cm.esc(text)}</td></tr>')
    if team.git_authors:
        tot = sum(team.git_authors.values())
        rows.append('<tr><td class="st na">git</td><td><b>Commits</b></td><td>' +
                    ", ".join(f"{cm.esc(a)} <span class=dim>{k}</span>" for a, k in
                              team.git_authors.most_common()) + f" <span class=dim>({tot} total)</span></td></tr>")
    parts.append(f'<section id="checks"><h2>Checklist</h2><div class="panel"><table class="checks">'
                 f'{"".join(rows)}</table></div></section>')

    # output
    if team.rush_results:
        order = sorted(team.rush_results, key=lambda n: (n != team.assigned, n))
        btns, panes = [], []
        for i, n in enumerate(order):
            R = team.rush_results[n]
            core = [t for t in R["tests"] if t["cat"] in ("subject", "core") and t["ok"] is not None]
            good = all(t["ok"] for t in core) and core
            mark = "✓" if good else "✗"
            lbl = f"rush{n:02d}" + (" ★" if n == team.assigned else "")
            btns.append(f'<button type="button" data-tab="r{n}" class="{"on" if i == 0 else ""}">{lbl}'
                        f'<span class="s">{mark}</span></button>')
            tiles = []
            spec = team.S.expected_for(n)
            if spec and spec["pattern"]:
                tiles.append(tile(spec["pattern"], None, "subject"))
            if R.get("theirs"):
                tiles.append(tile(R["theirs"], spec["pattern"] if spec and spec["pattern"] else None,
                                  f"theirs (from rush{PROBE})"))
            mode = {"subject": "Compared with subject.txt.",
                    "self": "No subject for this rush: compared with their own pattern (from the 6×5 "
                            "probe). <b>Check the tile against the PDF.</b>",
                    "shape": "No subject and no readable pattern: checking the shape only.",
                    None: ""}[R["mode"]]
            notes = "".join(f'<div class="subnote">⚠ {nt}</div>' for nt in R["notes"])
            cards = "".join(test_card(t) for t in R["tests"])
            if not R["tests"]:
                h = R.get("harness") or {}
                cards = f'<pre class="log">{cm.esc(h.get("log", ""))}</pre>'
            panes.append(f'<div data-pane="r{n}" {"" if i == 0 else "hidden"}>'
                         f'<div class="tiles">{"".join(tiles)}<div class="subnote" style="max-width:560px">'
                         f'{mode}<br>entry: <code>{cm.esc(R["entry"] or "?")}</code> in '
                         f'<code>{cm.esc(R["file"])}</code>. Edge cases (x or y ≤ 0, huge) are '
                         f'informational: the subject does not define them.</div></div>{notes}'
                         f'<div class="tests">{cards}</div></div>')
        parts.append(f'<section id="output"><h2>Output</h2><div data-tabs><div class="tabs">{"".join(btns)}</div>'
                     f'{"".join(panes)}</div></section>')

    # structure
    nodes, edges, amb = cm.build_graph(team.parsed, externals="*")
    for nid, nd in nodes.items():
        if nd["fn"] is None and nd["name"] not in team.cfg["allowed"]:
            flags.setdefault(nid, set()).add("forbidden")
    roots = [f.id for f in funcs if f.name == "main"]
    legend = "".join(f'<span><i style="background:{colors[f]}"></i>{cm.esc(f)}</span>' for f in files)
    legend += ('<span>thick border = entry · dashed = never called · red = over 25 lines · '
               'dashed arrow = name defined in several files</span>')
    fn_lines = {}
    cards = []
    for P in team.parsed:
        for f in P.funcs:
            fid = _fid(P.name)
            cards.append(cm.function_card(f, known, colors[P.name], flags.get(f.id, ()),
                                          line_href=lambda ln, fid=fid: f"#{fid}-L{ln}"))
    per_file = []
    for P in team.parsed:
        nf = len(P.funcs)
        per_file.append(f'<span><i style="background:{colors[P.name]}"></i><code>{cm.esc(P.name)}</code> '
                        f'{nf} fn{"s" if nf != 1 else ""}{" ⚠ >5" if nf > 5 else ""}</span>')
    parts.append(f'<section id="structure"><h2>Structure</h2>'
                 f'<div class="legend">{"".join(per_file)}</div>'
                 f'<div class="graphwrap">{cm.svg_graph(nodes, edges, amb, colors, roots, flags)}</div>'
                 f'<div class="legend">{legend}</div>'
                 f'<div class="cards">{"".join(cards)}</div></section>')

    # their main
    mains = []
    for n in sorted(team.rush_results):
        R = team.rush_results[n]
        own = R.get("own")
        if not own:
            continue
        r = own["run"]
        pat = R["pattern"]
        exp = "".join(render(pat, x, y) for x, y in own["calls"]) if pat and own["calls"] else None
        calls = ", ".join(f"<code>{cm.esc(R['entry'])}({x}, {y})</code>" for x, y in own["calls"]) or "(no literal calls found)"
        res = ""
        if exp is not None:
            res = (' <span class="st ok">✓ matches</span>' if exp == r["out"]
                   else ' <span class="st bad">✗ differs</span>')
        crash = crash_text(r)
        g = (f'<div class="grid">{grid_html(r["out"], exp)}</div>' if r["out"]
             else '<div class="empty">(no output)</div>')
        mains.append(f'<div class="panel" style="margin-bottom:10px"><b>rush{n:02d}</b> · calls {calls}{res}'
                     f'{"<div class=why>" + cm.esc(crash) + "</div>" if crash else ""}'
                     f'<div style="margin-top:6px">{g}</div></div>')
    parts.append(f'<section id="main"><h2>Their main.c, as turned in</h2>'
                 f'{"".join(mains) or "<p class=dim>not built</p>"}</section>')

    # questions
    parts.append('<section id="questions"><h2>Defense questions</h2><div class="panel"><ol class="qs">'
                 + "".join(f"<li>{q}</li>" for q in questions(team)) + "</ol></div></section>")

    # source
    srcs = []
    for P in team.parsed:
        fid = _fid(P.name)
        bad = {}
        for l, col, code, msg in team.norm.get(P.name, {}).get("errors", []):
            if l:
                bad[l] = (bad.get(l, "") + f"{code}: {msg} ").strip()
        fl = {f.line: cm.fn_anchor(f) for f in P.funcs}
        nerr = len(team.norm.get(P.name, {}).get("errors", []))
        srcs.append(f'<details open id="{fid}"><summary><code>{cm.esc(P.name)}</code> '
                    f'<span class=dim>{P.src.count(chr(10))} lines'
                    f'{f" · {nerr} norm error(s)" if nerr else ""}</span></summary>'
                    f'{cm.source_html(P, fid, fl, bad)}</details>')
    parts.append(f'<section id="source"><h2>Source</h2>{"".join(srcs)}</section>')
    return cm.page(f"{team.name} · rush00", "".join(parts), EXTRA_CSS)


def index_html(summaries, subject):
    rows = []
    for s in sorted(summaries, key=lambda s: s["team"]):
        vc, vt = s["verdict"]
        rcells = []
        for n, r in sorted(s["rushes"].items(), key=lambda kv: int(kv[0])):
            n = int(n)
            p, t = r["core"]
            good = p == t and t
            star = " ★" if s["assigned"] == n else ""
            rcells.append(f'<span class="st {"ok" if good else "bad"}">rush{n:02d}{star} {p}/{t}</span>')
        norm = {True: '<span class="st ok">✓</span>', False: '<span class="st bad">✗</span>',
                None: '<span class="st na">–</span>'}[s["norm_ok"]]
        forb = (f'<span class="st bad">{cm.esc(", ".join(s["forbidden"]))}</span>' if s["forbidden"]
                else '<span class="st ok">✓</span>')
        rows.append(f'<tr><td><a href="{cm.esc(s["team"])}.html"><b>{cm.esc(s["team"])}</b></a></td>'
                    f'<td><span class="pill {vc}">{cm.esc(vt)}</span></td>'
                    f'<td>{"rush%02d" % s["assigned"] if s["assigned"] is not None else "?"}</td>'
                    f'<td>{norm}</td><td>{forb}</td><td>{" ".join(rcells)}</td>'
                    f'<td class="dim">{cm.esc(s["time"])}</td></tr>')
    # pattern consensus: what each team's code draws, per rush number
    cons = {}
    for s in summaries:
        for n, r in s["rushes"].items():
            if r.get("theirs"):
                cons.setdefault(int(n), {}).setdefault(tuple(r["theirs"]), []).append(s["team"])
    blocks = []
    for n in sorted(cons):
        spec = subject.expected_for(n)
        sp = spec["pattern"] if spec else None
        items = []
        if sp:
            items.append(tile(sp, None, "subject"))
        for pat, teams in sorted(cons[n].items(), key=lambda kv: -len(kv[1])):
            p3 = [list(x) for x in pat]
            items.append(tile(p3, sp, f"{len(teams)} team(s): " + ", ".join(teams)))
        blocks.append(f'<div class="panel"><b>rush{n:02d}</b>'
                      f'<div class="tiles" style="margin-top:8px">{"".join(items)}</div></div>')
    body = (f'<header class="top"><h1>Rush00 · evaluations</h1><span class="dim">{len(summaries)} team(s) · '
            f'subject: {"subject.txt" if subject.loaded else "built-in core only"}</span>'
            f'<button class="themebtn" type="button">◐ theme</button></header>'
            f'<section><div class="panel" style="overflow:auto"><table class="checks"><tr class=dim>'
            f'<td>team</td><td>verdict</td><td>assigned</td><td>norm</td><td>forbidden</td>'
            f'<td>core cases per rush (★ = assigned)</td><td>evaluated</td></tr>{"".join(rows)}</table></div></section>'
            f'<section><h2>What each team draws</h2><p class="dim">Each team\'s pattern, read from its own '
            f'rush(6, 5). Red cells disagree with subject.txt. With no subject loaded, the odd one out is '
            f'the one to check against the PDF.</p><div class="cons">{"".join(blocks) or "<p class=dim>nothing yet</p>"}</div></section>')
    return cm.page("Rush00 evaluations", body, EXTRA_CSS)


