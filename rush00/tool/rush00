RUSH_FILE = re.compile(r"^rush(\d\d)\.c$")


def file_regex(name):
    return re.compile("^" + re.escape(name).replace("X", r"\d") + "$")


def find_ex_dir(team, want):
    cands = []
    for dp, dns, fns in os.walk(team):
        dns[:] = sorted(d for d in dns if not d.startswith("."))
        if os.path.relpath(dp, team).count(os.sep) > 3:
            dns[:] = []
            continue
        if any(RUSH_FILE.match(f) for f in fns):
            cands.append(dp)
    if not cands:
        return None
    cands.sort(key=lambda d: (os.path.basename(d) != want, d.count(os.sep), d))
    return cands[0]


def save_team_meta(name, leader=None, rush=None):
    """Set (or clear, with empty values) one team's leader/rush in repo/teams.txt."""
    meta = load_teams_file()
    d = meta.setdefault(name, {})
    for k, v in (("leader", leader), ("rush", rush)):
        if v is None:
            continue
        if str(v).strip() == "":
            d.pop(k, None)
        else:
            d[k] = str(v).strip()
    os.makedirs(REPO_DIR, exist_ok=True)
    with open(TEAMS_FILE, "w", encoding="utf-8") as f:
        f.write("# team  leader=LOGIN  rush=N   (read by rush00)\n")
        for t, kv in sorted(meta.items()):
            if kv:
                f.write(t + "  " + "  ".join(f"{k}={v}" for k, v in sorted(kv.items())) + "\n")


def load_teams_file():
    meta = {}
    if os.path.exists(TEAMS_FILE):
        for ln in open(TEAMS_FILE, encoding="utf-8"):
            ln = ln.split("#")[0].split()
            if not ln:
                continue
            d = {}
            for kv in ln[1:]:
                if "=" in kv:
                    k, v = kv.split("=", 1)
                    d[k] = v
            meta[ln[0]] = d
    return meta


class Team:
    def __init__(self, path, subject, leader=None, rush=None, norm=True):
        self.path = os.path.realpath(path)
        self.name = os.path.basename(self.path.rstrip("/"))
        self.S = subject
        self.cfg = subject.cfg
        self.norm_enabled = norm
        self.leader = leader
        self.assigned = rush
        self.assigned_why = "given with --rush" if rush is not None else ""
        self.checks = []          # (label, status, detail_html, detail_text)
        self.rush_results = {}    # n -> dict
        self.norm = {}
        self.forbidden = []
        self.parsed = []
        self.git_authors = None
        self.ex = None
        self.work = tempfile.mkdtemp(prefix=f"rush00-{self.name}-")

    def check(self, label, status, html="", text=""):
        self.checks.append((label, status, html, text))

    # ------------------------------------------------------------------
    def evaluate(self):
        self.ex = find_ex_dir(self.path, self.cfg["dir"])
        if not self.ex:
            self.check("Turn-in", "bad", "", "no rushNN.c anywhere in this folder")
            return self
        self.files = sorted(f for f in os.listdir(self.ex) if os.path.isfile(os.path.join(self.ex, f)))
        self.cfiles = [f for f in self.files if f.endswith(".c")]
        self.rush_files = sorted(f for f in self.cfiles if RUSH_FILE.match(f))
        self.helpers = [f for f in self.cfiles if f not in self.rush_files
                        and f not in ("main.c", "ft_putchar.c")]
        self._turn_in()
        self._parse()
        self._norm()
        self._forbidden()
        self._pick_assigned()
        for rf in self.rush_files:
            self.rush_results[int(RUSH_FILE.match(rf).group(1))] = self._rush(rf)
        self._summary_checks()
        return self

    def _turn_in(self):
        rel = os.path.relpath(self.ex, self.path)
        want = self.cfg["dir"]
        regs = [file_regex(f) for f in self.cfg["files"]]
        missing = [f for f, r in zip(self.cfg["files"], regs)
                   if not any(r.match(x) for x in self.files)]
        extra = [f for f in self.files if not any(r.match(f) for r in regs)]
        notes = []
        status = "ok"
        if os.path.basename(self.ex) != want:
            notes.append(f"files are in <code>{cm.esc(rel)}/</code>, not <code>{cm.esc(want)}/</code>")
            status = "bad"
        if missing:
            notes.append("missing: " + ", ".join(f"<code>{cm.esc(m)}</code>" for m in missing))
            status = "bad"
        if extra:
            notes.append("extra files: " + ", ".join(f"<code>{cm.esc(e)}</code>" for e in extra))
            status = "warn" if status == "ok" else status
        top = [f for f in os.listdir(self.path) if not f.startswith(".")
               and os.path.join(self.path, f) != self.ex
               and not self.ex.startswith(os.path.join(self.path, f) + os.sep)]
        if top:
            notes.append("also at repo root: " + ", ".join(f"<code>{cm.esc(t)}</code>" for t in top))
        listing = " ".join(f"<code>{cm.esc(f)}</code>" for f in self.files)
        self.check("Turn-in files", status,
                   f"<div><code>{cm.esc(rel)}/</code> → {listing}</div>"
                   + "".join(f"<div>{n}</div>" for n in notes),
                   "; ".join(re.sub("<[^>]+>", "", n) for n in notes) or f"{rel}/ ok")

    def _parse(self):
        for f in self.cfiles + [f for f in self.files if f.endswith(".h")]:
            self.parsed.append(cm.parse_file(os.path.join(self.ex, f)))
        self.git_authors = cm.attach_authors(self.parsed, self.path)

    def _norm(self):
        if not self.norm_enabled:
            self.check("Norminette", "na", "", "skipped (--no-norm)")
            return
        if not shutil.which("norminette"):
            self.check("Norminette", "na", "", "norminette not installed")
            return
        files = [f for f in self.files if f.endswith((".c", ".h"))]
        rc, out, err = run(["norminette", "-R", "CheckForbiddenSourceHeader"] + files, cwd=self.ex)
        if rc not in (0, 1) or "usage" in (out + err).lower()[:200]:
            rc, out, err = run(["norminette"] + files, cwd=self.ex)
        cur = None
        per = {f: {"ok": None, "errors": []} for f in files}
        for ln in out.splitlines():
            m = re.match(r"^(.+?): (OK|Error)!", ln)
            if m:
                cur = m.group(1)
                per.setdefault(cur, {"ok": None, "errors": []})["ok"] = m.group(2) == "OK"
                continue
            m = re.match(r"^\s*Error:\s*(\S+)\s*\(line:\s*(\d+),\s*col:\s*(\d+)\):\s*(.*)", ln)
            if m and cur:
                per[cur]["errors"].append((int(m.group(2)), int(m.group(3)), m.group(1), m.group(4).strip()))
            elif ln.strip().startswith("Error") and cur:
                per[cur]["errors"].append((0, 0, "", ln.strip()))
        self.norm = per
        nerr = sum(len(v["errors"]) for v in per.values())
        bad = [f for f, v in per.items() if v["ok"] is False]
        rows = []
        for f, v in per.items():
            st = "✓" if v["ok"] else ("✗" if v["ok"] is False else "?")
            errs = "".join(f"<div class=dim><a href=\"#{_fid(f)}-L{l}\">L{l}:{col}</a> "
                           f"<code>{cm.esc(code)}</code> {cm.esc(msg)}</div>"
                           for l, col, code, msg in v["errors"][:12])
            more = f"<div class=dim>… {len(v['errors']) - 12} more</div>" if len(v["errors"]) > 12 else ""
            rows.append(f"<div><b>{st}</b> <code>{cm.esc(f)}</code>{errs}{more}</div>")
        self.check("Norminette", "bad" if bad else ("ok" if per else "na"), "".join(rows),
                   f"{nerr} error(s) in {', '.join(bad)}" if bad else "all files OK")

    def _forbidden(self):
        allowed = set(self.cfg["allowed"])
        objdir = os.path.join(self.work, "obj")
        os.makedirs(objdir, exist_ok=True)
        undefined, defined, fails = {}, set(), []
        for f in self.cfiles:
            o = os.path.join(objdir, f + ".o")
            rc, _, err = run([CC, "-c", "-w", os.path.join(self.ex, f), "-o", o])
            if rc != 0:
                rc, _, err = run([CC, "-c", "-w", "-fpermissive", os.path.join(self.ex, f), "-o", o])
            if rc != 0:
                fails.append(f)
                continue
            _, out, _ = run(["nm", "-u", o])
            for ln in out.split("\n"):
                sym = ln.split()[-1] if ln.split() else ""
                if sym:
                    undefined.setdefault(sym, []).append(f)
            _, out, _ = run(["nm", "--defined-only", o])
            defined.update(ln.split()[-1] for ln in out.split("\n") if ln.split())
        internal = re.compile(r"^(_GLOBAL_OFFSET_TABLE_|__stack_chk_fail|__stack_chk_guard|_?_?main)$")
        mine = {f.name for P in self.parsed for f in P.funcs} | set(allowed)
        found = {s: fs for s, fs in undefined.items()
                 if s not in defined and s not in mine and not internal.match(s)}
        # also what the source calls (the compiler may turn printf("\n") into putchar)
        protos = {p for P in self.parsed for p in P.protos}
        for P in self.parsed:
            for fn in P.funcs:
                for name, line in fn.calls:
                    if name not in mine and not (name in protos and name not in undefined):
                        found.setdefault(name, [])
                        loc = f"{P.name}:{line}"
                        if loc not in found[name]:
                            found[name].append(loc)
        self.forbidden = sorted(found.items())
        headers = sorted({inc for P in self.parsed for inc in P.includes})
        hdr = (" · includes " + ", ".join(f"<code>{cm.esc(h)}</code>" for h in headers)) if headers else ""
        if self.forbidden:
            self.check("Forbidden functions", "bad",
                       ", ".join(f"<code>{cm.esc(s)}</code> in {cm.esc(', '.join(fs))}"
                                 for s, fs in self.forbidden) + hdr,
                       "uses " + ", ".join(s for s, _ in self.forbidden))
        elif fails:
            self.check("Forbidden functions", "warn", f"could not compile {', '.join(fails)}" + hdr,
                       f"could not compile {', '.join(fails)}")
        else:
            self.check("Forbidden functions", "ok",
                       "only " + ", ".join(f"<code>{cm.esc(a)}</code>" for a in sorted(allowed)) + hdr,
                       "only " + ", ".join(sorted(allowed)))

    def _pick_assigned(self):
        nums = [int(RUSH_FILE.match(f).group(1)) for f in self.rush_files]
        if self.assigned is None and self.leader:
            a = self.S.assigned_rush(self.leader)
            if a is not None:
                self.assigned = a
                self.assigned_why = f"leader {self.leader} → rule {self.cfg['assign']}"
        if self.assigned is None and len(nums) == 1:
            self.assigned = nums[0]
            self.assigned_why = "only rush file turned in"
        if self.assigned is not None and self.assigned not in nums:
            self.check("Assigned rush", "bad", "",
                       f"rush{self.assigned:02d}.c is not in the turn-in ({self.assigned_why})")

    # ------------------------------------------------------------------
    def _entry(self, rf):
        P = next(p for p in self.parsed if p.name == rf)
        two = [f for f in P.funcs if len(f.params) == 2
               and all(re.match(r"^(const\s+)?int\b", p) for p in f.params)]
        want = self.cfg["function"]
        stem = rf[:-2]
        for pick in ([f for f in two if f.name == want], [f for f in two if f.name == stem], two,
                     [f for f in P.funcs if f.name in (want, stem)]):
            if pick:
                called = {c for p in self.parsed if p.name == rf for fn in p.funcs for c in fn.callees()}
                roots = [f for f in pick if f.name not in called] or pick
                return roots[0]
        return None

    def _rush(self, rf):
        n = int(RUSH_FILE.match(rf).group(1))
        R = {"file": rf, "n": n, "entry": None, "official": None, "own": None,
             "tests": [], "probe": None, "mode": None, "pattern": None, "notes": []}
        entry = self._entry(rf)
        if not entry:
            R["notes"].append("no rush(int x, int y)-shaped function found")
            return R
        R["entry"] = entry.name
        if entry.name != self.cfg["function"]:
            R["notes"].append(f"entry function is <code>{cm.esc(entry.name)}</code>, subject asks for "
                              f"<code>{cm.esc(self.cfg['function'])}</code>")
        d = os.path.join(self.work, f"rush{n:02d}")
        os.makedirs(d, exist_ok=True)
        R["official"] = self._official_build(rf, d)
        R["own"] = self._own_main_run(R, entry, d) if R["official"]["ok"] else None
        h = self._harness_build(rf, entry.name, d)
        R["harness"] = h
        if not h["ok"]:
            R["notes"].append("could not build the test harness")
            return R
        exe = h["exe"]
        probe = run_capped([exe, str(PROBE[0]), str(PROBE[1])], d)
        prows = probe["out"].split("\n")[:-1] if probe["out"].endswith("\n") else probe["out"].split("\n")
        R["probe"] = probe
        inferred, conf = derive_pattern([(PROBE[0], PROBE[1], prows)])
        theirs = inferred if shape_ok(PROBE[0], PROBE[1], prows) and not conf \
            and all(ch is not None for row in inferred for ch in row) else None
        R["theirs"] = theirs
        spec = self.S.expected_for(n)
        if spec:
            R["mode"] = "subject"
            R["pattern"] = spec["pattern"]
            R["notes"].extend(spec["notes"])
        elif theirs:
            R["mode"] = "self"
            R["pattern"] = theirs
        else:
            R["mode"] = "shape"
        cases = []
        if spec:
            for x, y, rows in spec["valid_examples"]:
                cases.append((x, y, "subject", "\n".join(rows) + "\n"))
        gen_pat = (spec["pattern"] if spec and spec["generate"] else None) if spec else theirs
        seen = {(x, y) for x, y, _, _ in cases}
        for x, y in CORE_CASES:
            if (x, y) not in seen:
                cases.append((x, y, "core", render(gen_pat, x, y) if gen_pat else None))
        for x, y in EDGE_CASES:
            cases.append((x, y, "edge", ""))
        for x, y in STRESS_CASES:
            cases.append((x, y, "stress", render(gen_pat, x, y) if gen_pat else None))
        for x, y, cat, exp in cases:
            r = run_capped([exe, str(x), str(y)], d)
            R["tests"].append(judge(x, y, cat, exp, r))
        return R

    def _official_build(self, rf, d):
        srcs = [f for f in ("main.c", "ft_putchar.c") if f in self.files] + [rf] + self.helpers
        exe = os.path.join(d, "a.out")
        cmd = [CC] + self.cfg["flags"] + srcs + ["-o", exe]
        rc, out, err = run(cmd, cwd=self.ex)
        res = {"ok": rc == 0, "cmd": " ".join([CC] + self.cfg["flags"] + srcs),
               "log": (out + err).strip(), "exe": exe, "whole": False}
        if rc != 0 and len(self.rush_files) > 1 and "undefined reference" in err:
            # their main.c calls several rushNN() at once: try the whole folder together
            allc = self.cfiles
            rc2, out2, err2 = run([CC] + self.cfg["flags"] + allc + ["-o", exe], cwd=self.ex)
            if rc2 == 0:
                res.update(ok=True, whole=True, cmd=" ".join([CC] + self.cfg["flags"] + allc),
                           log=f"alone it fails ({first_error(err)});\nbuilds only with every file together")
        return res

    def _own_main_run(self, R, entry, d):
        r = run_capped([R["official"]["exe"]], d)
        main = next((f for P in self.parsed if P.name == "main.c" for f in P.funcs if f.name == "main"), None)
        calls = []
        if main:
            P = next(p for p in self.parsed if p.name == "main.c")
            body = P.src[P.toks[0].s:] if P.toks else ""
            lines = P.src.split("\n")[main.open_line - 1:main.close_line]
            body = "\n".join(lines)
            for m in re.finditer(r"\b" + re.escape(entry.name) + r"\s*\(\s*(-?\d+)\s*,\s*(-?\d+)\s*\)", body):
                calls.append((int(m.group(1)), int(m.group(2))))
        return {"run": r, "calls": calls}

    def _harness_build(self, rf, entry, d):
        hc = os.path.join(d, "__harness.c")
        with open(hc, "w") as f:
            f.write("#include <stdlib.h>\n"
                    f"void {entry}(int x, int y);\n"
                    "int main(int ac, char **av)\n{\n"
                    f"\tif (ac < 3)\n\t\treturn (2);\n\t{entry}(atoi(av[1]), atoi(av[2]));\n"
                    "\treturn (0);\n}\n")
        srcs = [f for f in ("ft_putchar.c",) if f in self.files] + [rf] + self.helpers
        objs, log = [], []
        sect = ["-ffunction-sections", "-fdata-sections", "-w"]
        for s in srcs + (["main.c"] if "main.c" in self.files else []):
            o = os.path.join(d, s + ".h.o")
            extra = ["-Dmain=__rush_student_main"] if s == "main.c" else []
            rc, out, err = run([CC, "-c"] + sect + extra + [os.path.join(self.ex, s), "-o", o])
            if rc != 0:  # e.g. implicit write() is a hard error on gcc >= 14: still show the output
                rc, out, err = run([CC, "-c", "-fpermissive"] + sect + extra
                                   + [os.path.join(self.ex, s), "-o", o])
            if rc != 0:
                log.append(err)
                if s != "main.c":
                    return {"ok": False, "log": "\n".join(log)}
                continue
            objs.append(o)
        ho = os.path.join(d, "__harness.o")
        run([CC, "-c", "-w", hc, "-o", ho])
        exe = os.path.join(d, "harness")
        rc, out, err = run([CC, "-Wl,--gc-sections", ho] + objs + ["-o", exe])
        if rc != 0 and any(o.endswith("main.c.h.o") for o in objs):
            objs = [o for o in objs if not o.endswith("main.c.h.o")]
            rc, out, err = run([CC, "-Wl,--gc-sections", ho] + objs + ["-o", exe])
        return {"ok": rc == 0, "exe": exe, "log": ("\n".join(log) + err).strip()}

    # ------------------------------------------------------------------
    def _summary_checks(self):
        rank = {"ok": 0, "na": 0, "warn": 1, "bad": 2}
        for n, R in sorted(self.rush_results.items()):
            tag = f"rush{n:02d}" + (" (assigned)" if n == self.assigned else
                                    " (bonus)" if self.assigned is not None else "")
            off = R["official"]
            notes_txt = [re.sub("<[^>]+>", "", x) for x in R["notes"]]
            if off is None:
                self.check(tag, "bad", "<br>".join(R["notes"]), "; ".join(notes_txt))
                continue
            flags = " ".join(self.cfg["flags"])
            if off["whole"]:
                b_st, b_txt = "warn", "builds only with every rush file together"
            elif off["ok"]:
                b_st, b_txt = "ok", f"builds with {flags}"
            else:
                b_st, b_txt = "bad", "build fails: " + first_error(off["log"])
            core = [t for t in R["tests"] if t["cat"] in ("subject", "core")]
            judged = [t for t in core if t["ok"] is not None]
            passed = sum(1 for t in judged if t["ok"])
            mode = {"subject": "vs subject", "self": "vs their own pattern (no subject)",
                    "shape": "shape only", None: ""}[R["mode"]]
            if not R["tests"]:
                o_st, o_txt = "bad", "not tested"
            else:
                o_st = "ok" if judged and passed == len(judged) else "bad"
                if o_st == "ok" and R["mode"] != "subject":
                    o_st = "warn"
                o_txt = f"{passed}/{len(judged)} core cases {mode}"
            st = max([b_st, o_st] + (["warn"] if R["notes"] else []), key=rank.get)
            html_ = (f'<div><span class="st {b_st}">{"✓" if b_st == "ok" else "!" if b_st == "warn" else "✗"}</span> '
                     f'{cm.esc(b_txt)} <details style="display:inline"><summary class=dim style="display:inline">'
                     f'cmd</summary><code>{cm.esc(off["cmd"])}</code>'
                     + (f'<pre class=log>{cm.esc(off["log"])}</pre>' if off["log"] else "")
                     + f'</details></div><div><span class="st {o_st}">{"✓" if o_st == "ok" else "!" if o_st == "warn" else "✗"}</span> '
                     f'<a href="#output">{cm.esc(o_txt)}</a></div>'
                     + "".join(f'<div class="dim">⚠ {nt}</div>' for nt in R["notes"]))
            self.check(tag, st, html_, " · ".join([b_txt, o_txt] + notes_txt))

    def verdict(self):
        n = self.assigned
        if n is None and len(self.rush_results) > 1:
            return "warn", "ASSIGNED RUSH UNKNOWN"
        hard = [x for x in self.checks if x[1] == "bad"
                and (n is None or "rush" not in x[0][:4] or x[0].startswith(f"rush{n:02d}"))]
        if not self.ex:
            return "bad", "NOTHING TO GRADE"
        if hard:
            return "bad", "FAIL"
        R = self.rush_results.get(n) if n is not None else None
        if R and R["mode"] != "subject":
            return "warn", "PASS? (check pattern vs PDF)"
        return "ok", "PASS"

    def summary(self):
        v = self.verdict()
        rushes = {}
        for n, R in self.rush_results.items():
            core = [t for t in R["tests"] if t["cat"] in ("subject", "core") and t["ok"] is not None]
            rushes[n] = {"build": bool(R["official"] and R["official"]["ok"]),
                         "core": [sum(t["ok"] for t in core), len(core)], "mode": R["mode"],
                         "theirs": ["".join(r) for r in R["theirs"]] if R.get("theirs") else None,
                         "entry": R["entry"]}
        return {"team": self.name, "path": self.path, "verdict": v, "assigned": self.assigned,
                "assigned_why": self.assigned_why, "leader": self.leader,
                "norm_ok": all(x["ok"] for x in self.norm.values()) if self.norm else None,
                "forbidden": [s for s, _ in self.forbidden], "rushes": rushes,
                "checks": [(a, b, d) for a, b, _, d in self.checks],
                "time": time.strftime("%Y-%m-%d %H:%M")}

    def cleanup(self):
        shutil.rmtree(self.work, ignore_errors=True)


def _fid(fname):
    return "src-" + re.sub(r"[^A-Za-z0-9]", "-", fname)


def first_error(log):
    lines = [l for l in log.split("\n") if l.strip()]
    for l in sorted(lines, key=lambda l: (l.startswith("collect2"),
                                          not re.search(r"undefined reference|multiple definition", l))):
        if re.search(r"error|undefined reference|multiple definition", l, re.I):
            return re.sub(r"^/usr/bin/ld: (/tmp/\S+: )?", "", l).strip()[:160]
    return (lines[0] if lines else "")[:160]


def judge(x, y, cat, exp, r):
    got = r["out"]
    t = {"x": x, "y": y, "cat": cat, "exp": exp, "got": got, "size": r["size"],
         "crash": crash_text(r), "ok": None, "why": ""}
    if t["crash"]:
        t["ok"] = False
        t["why"] = t["crash"]
        if cat == "edge" and r["timeout"]:
            t["why"] += " — probably loops over x even when y is 0 (or vice versa)"
        return t
    if r["size"] > len(got):
        got = None
    if exp is None:
        # no reference: at least the shape must be right
        rows = got.split("\n") if got is not None else []
        if rows and rows[-1] == "":
            rows.pop()
        t["ok"] = got is not None and got.endswith("\n") and shape_ok(x, y, rows)
        t["why"] = "" if t["ok"] else f"expected {y} rows of {x} chars"
        return t
    if got is None:
        t["ok"] = False
        t["why"] = f"printed {r['size']:,} bytes, expected {len(exp):,}"
        return t
    t["ok"] = got == exp
    if not t["ok"]:
        t["why"] = diff_text(exp, got)
    return t


def _rows(s):
    rows = s.split("\n")
    if rows and rows[-1] == "":
        rows.pop()
    return rows


def diff_text(exp, got):
    if exp == "" and got:
        return f"expected no output, got {len(got)} bytes"
    if got == "":
        return "printed nothing"
    e, g = _rows(exp), _rows(got)
    for r in range(max(len(e), len(g))):
        a = e[r] if r < len(e) else None
        b = g[r] if r < len(g) else None
        if a != b:
            if a is None:
                return f"extra row {r + 1}: {b[:40]!r}"
            if b is None:
                return f"missing row {r + 1} (got {len(g)} rows, want {len(e)})"
            for col in range(max(len(a), len(b))):
                ca = a[col] if col < len(a) else None
                cb = b[col] if col < len(b) else None
                if ca != cb:
                    return (f"row {r + 1} col {col + 1}: want {ca!r} got {cb!r}"
                            if ca and cb else f"row {r + 1}: width {len(b)}, want {len(a)}")
    if exp.endswith("\n") and not got.endswith("\n"):
        return "missing the final newline"
    return "differs"


