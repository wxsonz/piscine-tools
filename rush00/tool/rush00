ANSI = re.compile(r"\x1b\[[0-9;]*m")


def run(cmd, cwd=None, timeout=60):
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout,
                           errors="replace")
        return p.returncode, ANSI.sub("", p.stdout), ANSI.sub("", p.stderr)
    except subprocess.TimeoutExpired:
        return None, "", "timed out"
    except OSError as e:
        return None, "", str(e)


def run_capped(cmd, cwd, timeout=RUN_TIMEOUT, cap=2_000_000):
    with tempfile.TemporaryFile() as out:
        timed_out = False
        try:
            p = subprocess.run(cmd, cwd=cwd, stdout=out, stderr=subprocess.PIPE,
                               stdin=subprocess.DEVNULL, timeout=timeout)
            rc, err = p.returncode, p.stderr
        except subprocess.TimeoutExpired as e:
            rc, err, timed_out = None, e.stderr or b"", True
        size = out.seek(0, 2)
        out.seek(0)
        data = out.read(cap)
    return {"rc": rc, "timeout": timed_out, "size": size,
            "out": data.decode("latin-1"), "err": err.decode("utf-8", "replace")[:2000]}


def crash_text(r):
    if r["timeout"]:
        return f"timeout after {RUN_TIMEOUT}s ({r['size']:,} bytes printed)"
    if r["rc"] is not None and r["rc"] < 0:
        return "crashed: " + SIGNAMES.get(r["rc"], f"signal {-r['rc']}")
    return ""


