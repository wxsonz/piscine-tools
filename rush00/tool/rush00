def is_url(s):
    return bool(re.match(r"^(https?://|git@|ssh://|[\w.-]+@[\w.-]+:)", s))


def clone(url, name=None):
    name = name or re.sub(r"\.git$", "", url.rstrip("/").split("/")[-1].split(":")[-1])
    dest = os.path.join(REPO_DIR, name)
    os.makedirs(REPO_DIR, exist_ok=True)
    if os.path.exists(dest):
        print(c(DIM, f"  {name} already cloned — pulling"))
        subprocess.run(["git", "-C", dest, "pull", "--ff-only", "-q"])
    else:
        print(c(DIM, f"  cloning {url} → repo/{name}"))
        if subprocess.run(["git", "clone", "-q", url, dest]).returncode != 0:
            return None
    return dest


def print_team(team, report):
    vc, vt = team.verdict()
    col = {"ok": OK, "bad": BAD, "warn": WARN}[vc]
    rel = os.path.relpath(team.ex, team.path) if team.ex else "-"
    asg = f"rush{team.assigned:02d}" if team.assigned is not None else "?"
    print(f"\n{c(BOLD, '▸ ' + team.name)}  {c(col, vt)}  {c(DIM, rel + '/ · assigned ' + asg)}"
          + (c(DIM, f" ({team.assigned_why})") if team.assigned_why else ""))
    sym = {"ok": c(OK, "✓"), "bad": c(BAD, "✗"), "warn": c(WARN, "!"), "na": c(DIM, "–")}
    for label, st, _, text in team.checks:
        print(f"  {sym[st]} {label:44} {c(DIM, text[:110])}")
    for n, R in sorted(team.rush_results.items()):
        bad = [t for t in R["tests"] if t["ok"] is False and t["cat"] in ("subject", "core")]
        for t in bad[:4]:
            print(f"      {c(BAD, f'rush{n:02d}')} rush({t['x']}, {t['y']}): {t['why']}")
        edge = [t for t in R["tests"] if t["cat"] == "edge" and (t["got"] or t["crash"])]
        if edge:
            e = ", ".join(f"({t['x']},{t['y']})" for t in edge[:5])
            print(c(DIM, f"      rush{n:02d} edge cases with output/crash (informational): {e}"))
    print(f"  {c(CYAN, 'report')} {report}")


def evaluate(path, subject, leader, rush, norm, meta):
    name = os.path.basename(os.path.realpath(path))
    m = meta.get(name, {})
    leader = leader or m.get("leader")
    if rush is None and "rush" in m:
        rush = int(m["rush"])
    team = Team(path, subject, leader, rush, norm).evaluate()
    os.makedirs(REPORT_DIR, exist_ok=True)
    report = os.path.join(REPORT_DIR, f"{team.name}.html")
    with open(report, "w", encoding="utf-8") as f:
        f.write(report_html(team))
    with open(os.path.join(REPORT_DIR, f"{team.name}.json"), "w", encoding="utf-8") as f:
        json.dump(team.summary(), f, indent=1)
    print_team(team, report)
    team.cleanup()
    return report


def write_index(subject):
    sums = []
    if os.path.isdir(REPORT_DIR):
        for f in sorted(os.listdir(REPORT_DIR)):
            if f.endswith(".json") and not f.startswith("."):
                try:
                    with open(os.path.join(REPORT_DIR, f), encoding="utf-8") as fh:
                        d = json.load(fh)
                    if isinstance(d, dict) and "team" in d:
                        sums.append(d)
                except (OSError, ValueError):
                    pass
    path = os.path.join(REPORT_DIR, "index.html")
    os.makedirs(REPORT_DIR, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(index_html(sums, subject))
    return path


def main(argv):
    opts = {"leader": None, "rush": None, "open": False, "norm": True, "port": 4242}
    targets = []
    it = iter(argv)
    for a in it:
        if a == "--leader":
            opts["leader"] = next(it, None)
        elif a == "--rush":
            opts["rush"] = int(next(it, "0"))
        elif a == "--open":
            opts["open"] = True
        elif a == "--port":
            opts["port"] = int(next(it, "4242"))
        elif a == "--no-norm":
            opts["norm"] = False
        elif a in ("-h", "--help"):
            print(__doc__)
            return 0
        else:
            targets.append(a)
    if targets[:1] == ["init"]:
        return cmd_init()
    if targets[:1] == ["subject"]:
        if len(targets) < 2:
            print_subject(Subject.load())
            return 0
        return cmd_subject(targets[1])
    if targets[:1] == ["serve"]:
        import web
        return web.serve(sys.modules[__name__], opts["port"], opts["open"])

    S = Subject.load()
    for note in S.notes:
        print(c(WARN, "subject.txt: " + note))
    if not S.loaded:
        print(c(WARN, "no subject.txt — checking against the built-in core only "
                      "(`rush00 subject today.pdf` once you have the PDF)"))
    meta = load_teams_file()
    if not targets:
        if not os.path.isdir(REPO_DIR):
            print(f"nothing in {REPO_DIR}")
            return 1
        targets = [os.path.join(REPO_DIR, d) for d in sorted(os.listdir(REPO_DIR))
                   if os.path.isdir(os.path.join(REPO_DIR, d)) and not d.startswith(".")]
        if not targets:
            print(f"no team folders in {REPO_DIR} — drop one in, or `rush00 <git-url>`")
            return 1
    reports = []
    for t in targets:
        if is_url(t):
            t = clone(t)
            if not t:
                continue
        elif not os.path.isdir(t) and os.path.isdir(os.path.join(REPO_DIR, t)):
            t = os.path.join(REPO_DIR, t)
        if not os.path.isdir(t):
            print(c(BAD, f"not a folder: {t}"))
            continue
        if not find_ex_dir(t, S.cfg["dir"]):
            print(c(DIM, f"\n▸ {os.path.basename(t)}: no rushNN.c — skipped (not a rush00 repo?)"))
            continue
        reports.append(evaluate(t, S, opts["leader"], opts["rush"], opts["norm"], meta))
    idx = write_index(S)
    print(f"\n{c(CYAN, 'all teams')} {idx}")
    if opts["open"] and reports:
        webbrowser.open("file://" + (reports[0] if len(reports) == 1 else idx))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
