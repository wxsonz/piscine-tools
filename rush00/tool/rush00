EX_HEAD = re.compile(r"rush\s*\(\s*(-?\d+)\s*,\s*(-?\d+)\s*\)")


class Subject:
    def __init__(self):
        self.cfg = dict(DEFAULTS)
        self.rushes = {}      # n -> {"pattern": 3x3|None, "examples": [(x, y, rows)]}
        self.loaded = False
        self.notes = []       # warnings found while reading/deriving
        self.derived = {}     # n -> {"pattern", "source", "valid_examples", "generate", "notes"}

    # -- reading ------------------------------------------------------------
    @classmethod
    def load(cls, path=SUBJECT):
        s = cls()
        if os.path.exists(path):
            with open(path, encoding="utf-8") as f:
                s.parse(f.read())
            s.loaded = True
        s.derive_all()
        return s

    def parse(self, text):
        sec, cur = None, None
        lines = text.split("\n")

        def finish():
            if cur is not None and sec is not None:
                rows = _clean_rows(cur["rows"], cur["x"])
                self.rushes[sec]["examples"].append((cur["x"], cur["y"], rows))

        i = 0
        while i < len(lines):
            raw = lines[i].rstrip("\r")
            s = raw.strip()
            if cur is not None:
                if s == "" or EX_HEAD.search(s) or s.startswith("=="):
                    finish()
                    cur = None
                    if s == "":
                        i += 1
                    continue
                if s.startswith("$>"):
                    i += 1
                    continue
                cur["rows"].append(raw)
                i += 1
                continue
            if s == "" or s.startswith("#"):
                i += 1
                continue
            if s.startswith("=="):
                m = re.search(r"\d+", s)
                sec = int(m.group()) if m else None
                if sec is not None:
                    self.rushes.setdefault(sec, {"pattern": None, "examples": []})
                i += 1
                continue
            m = EX_HEAD.search(s)
            if m and sec is not None:
                cur = {"x": int(m.group(1)), "y": int(m.group(2)), "rows": []}
                i += 1
                continue
            if "=" in s:
                k, v = s.split("=", 1)
                k, v = k.strip().lower(), v.split(" #")[0].strip()
                if k == "pattern" and sec is not None:
                    try:
                        parts = shlex.split(v)
                    except ValueError:
                        parts = []
                    if len(parts) == 3 and all(len(p) == 3 for p in parts):
                        self.rushes[sec]["pattern"] = [list(p) for p in parts]
                    else:
                        self.notes.append(f"rush{sec:02d}: bad pattern line (want 3 quoted "
                                          f"3-char rows): {v}")
                elif k in ("files", "allowed", "flags"):
                    self.cfg[k] = v.split()
                elif k in ("function", "dir", "assign"):
                    self.cfg[k] = v
            i += 1
        finish()

    # -- deriving -----------------------------------------------------------
    def derive_all(self):
        for n, r in self.rushes.items():
            self.derived[n] = derive_rush(r["pattern"], r["examples"])

    def expected_for(self, n):
        d = self.derived.get(n)
        return d if d and (d["pattern"] or d["valid_examples"]) else None

    def assigned_rush(self, leader):
        rule = (self.cfg.get("assign") or "").strip().lower()
        if not leader or not rule:
            return None
        if rule in ("leader-mod-5", "leader_mod_5"):
            ch = leader.strip().lower()[:1]
            if "a" <= ch <= "z":
                return (ord(ch) - ord("a") + 1) % 5
        return None


def _clean_rows(rows, x):
    rows = [r.replace("\t", "    ") for r in rows]
    # cat -e style paste: drop a trailing '$' on every row
    if rows and all(r.endswith("$") for r in rows) and any(len(r) - 1 == x for r in rows):
        rows = [r[:-1] for r in rows]
    nonblank = [r for r in rows if r.strip()]
    if nonblank:
        ind = min(len(r) - len(r.lstrip(" ")) for r in nonblank)
        rows = [r[ind:] for r in rows]
    return rows


def render(pat, x, y):
    if x <= 0 or y <= 0:
        return ""
    out = []
    for r in range(y):
        R = 0 if r == 0 else (2 if r == y - 1 else 1)
        out.append("".join(pat[R][0 if col == 0 else (2 if col == x - 1 else 1)]
                           for col in range(x)))
    return "\n".join(out) + "\n"


def derive_pattern(samples):
    """samples: [(x, y, rows)] -> (3x3 with None holes, conflicts)."""
    P = [[None] * 3 for _ in range(3)]
    conflicts = []
    for x, y, rows in samples:
        if x <= 0 or y <= 0:
            continue
        for ri, row in enumerate(rows):
            R = 0 if ri == 0 else (2 if ri == len(rows) - 1 else 1)
            for ci, ch in enumerate(row):
                C = 0 if ci == 0 else (2 if ci == len(row) - 1 else 1)
                if P[R][C] is None:
                    P[R][C] = ch
                elif P[R][C] != ch:
                    conflicts.append((R, C, P[R][C], ch, x, y))
    return P, conflicts


def shape_ok(x, y, rows):
    return len(rows) == y and all(len(r) == x for r in rows)


def derive_rush(pattern, examples):
    notes = []
    valid = [(x, y, rows) for x, y, rows in examples if shape_ok(x, y, rows)]
    for x, y, rows in examples:
        if not shape_ok(x, y, rows):
            notes.append(f"example rush({x}, {y}) is not {y} rows of {x} chars as pasted "
                         f"(spaces lost in the copy?) — used only to read the pattern")
    source = None
    if pattern:
        pat, source = pattern, "pattern line"
    else:
        pat, conflicts = derive_pattern(examples)
        for R, C, a, b, x, y in conflicts[:3]:
            notes.append(f"examples disagree on cell ({R},{C}): {a!r} vs {b!r} (rush({x}, {y}))")
        if pat[1][1] is None and all(pat[r][k] is not None for r in range(3) for k in range(3)
                                     if (r, k) != (1, 1)):
            pat[1][1] = " "
            notes.append("fill char never shown in the examples — assuming a space")
        if any(pat[r][k] is None for r in range(3) for k in range(3)) or conflicts:
            if not conflicts:
                notes.append("examples don't show every corner/edge — testing the examples only "
                             "(add a rush(5, 3)-sized example or a pattern = line)")
            pat = None
        else:
            source = "derived from examples"
    generate = pat is not None
    if pat:
        for x, y, rows in valid:
            if render(pat, x, y) != "\n".join(rows) + "\n":
                notes.append(f"pattern does not reproduce example rush({x}, {y}) — the subject's "
                             f"rule differs from the plain rectangle; testing examples only")
                generate = False
    return {"pattern": pat, "source": source, "valid_examples": valid,
            "generate": generate, "notes": notes}


